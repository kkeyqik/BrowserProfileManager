<ui:FluentWindow x:Class="BPM.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:BPM.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}"
                 Title="Browser Profile Manager"
                 Width="1360" Height="860" MinWidth="1100" MinHeight="580"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Backdrop behind everything: a deep colour with soft violet and cyan glows for the glass panels to sit on.
             Invisible in the light theme (transparent brush, glow opacity 0), where Windows' Mica shows instead. -->
        <Grid Grid.RowSpan="3" Background="{DynamicResource AppBackdropBrush}" IsHitTestVisible="False" ClipToBounds="True">
            <Grid Opacity="{DynamicResource GlassGlowOpacity}">
                <Ellipse Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-320,-380,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#A67C3AED" Offset="0" />
                            <GradientStop Color="#337C3AED" Offset="0.55" />
                            <GradientStop Color="#007C3AED" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="850" Height="850" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-340">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#8C06B6D4" Offset="0" />
                            <GradientStop Color="#2606B6D4" Offset="0.55" />
                            <GradientStop Color="#0006B6D4" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="260,-120,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#40DB2777" Offset="0" />
                            <GradientStop Color="#00DB2777" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>

        <ui:TitleBar Grid.Row="0" Title="Browser Profile Manager">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: scan + navigation (icons only when the window is narrow) -->
            <DockPanel Grid.Column="0" Margin="12,4,8,12">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Height="40"
                               Command="{Binding ScanCommand}" Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="Scan this PC: find every browser, profile and extension (read-only)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Scan this PC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavCompact}" Value="True">
                                        <Setter Property="Content" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:ProgressRing IsIndeterminate="True" Height="18" Width="18" Margin="0,8,0,0"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="4,6" ToolTip="{Binding Title}">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" />
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCollapsed}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: the selected page -->
            <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Page}" Focusable="False" />

            <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Column="1" VerticalAlignment="Bottom" Margin="24,0,24,16" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           Text="Scanning only reads files · nothing changes until you choose an action" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding Actions.IsBusy, Converter={StaticResource BoolToVisible}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" />
                    <TextBlock Text="{Binding Actions.BusyText}" Style="{StaticResource Caption}" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <ui:Button Content="Stop" Command="{Binding Actions.CancelCommand}" Margin="12,0,0,0" Padding="10,2" FontSize="12"
                               ToolTip="Stop after the current step. Changes already made stay made and are in the Change log." />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                           Visibility="{Binding Actions.IsBusy, Converter={StaticResource BoolToCollapsed}}" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
