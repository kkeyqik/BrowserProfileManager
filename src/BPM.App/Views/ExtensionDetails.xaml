<UserControl x:Class="BPM.App.Views.ExtensionDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BPM.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExtensionRow, IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Width="40" Height="40" Content="{Binding}" ContentTemplate="{StaticResource ExtensionIcon}" VerticalAlignment="Top" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource Body}" />
                    <TextBlock Text="{Binding Where}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>

            <!-- State -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatePill}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" Margin="6,0,0,0" Focusable="False" />
                <TextBlock Text="risk" Style="{StaticResource Caption}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ReasonText}" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"
                       Visibility="{Binding ReasonText, Converter={StaticResource EmptyToCollapsed}}" />

            <!-- Manage -->
            <TextBlock Text="In this profile" Style="{StaticResource Caption}" Margin="0,16,0,6" />
            <WrapPanel>
                <ui:Button Content="Turn off" Icon="{ui:SymbolIcon ToggleLeft24}" Command="{Binding TurnOffCommand}" Margin="0,0,6,6"
                           Visibility="{Binding Enabled, Converter={StaticResource BoolToVisible}}"
                           ToolTip="Opens the extension's page in this profile and flips its switch for you" />
                <ui:Button Content="Turn on" Appearance="Primary" Icon="{ui:SymbolIcon ToggleRight24}" Command="{Binding TurnOnCommand}" Margin="0,0,6,6"
                           Visibility="{Binding Enabled, Converter={StaticResource BoolToCollapsed}}"
                           ToolTip="Opens the extension's page in this profile and flips its switch for you" />
                <ui:Button Content="Open its page" Icon="{ui:SymbolIcon WindowNew24}" Command="{Binding ShowPageCommand}" Margin="0,0,6,6" />
                <ui:Button Content="Remove…" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}" Margin="0,0,6,6"
                           Visibility="{Binding IsChromium, Converter={StaticResource BoolToVisible}}" />
            </WrapPanel>

            <StackPanel Visibility="{Binding IsChromium, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="In every profile" Style="{StaticResource Caption}" Margin="0,8,0,6" />
                <ui:Button Content="Remove from every profile…" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveEverywhereCommand}" Margin="0,0,6,6"
                           ToolTip="Uninstalls it from every profile that has it, one by one. Nothing is blocked: you can install it again any time." />
            </StackPanel>

            <StackPanel Visibility="{Binding SupportsPolicies, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding AllProfilesText}" Style="{StaticResource Caption}" Margin="0,8,0,6" TextWrapping="Wrap" />
                <WrapPanel>
                    <ui:Button Content="Block everywhere…" Icon="{ui:SymbolIcon ShieldDismiss24}" Command="{Binding BlockEverywhereCommand}" Margin="0,0,6,6" />
                    <ui:Button Content="Unblock…" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding UnblockEverywhereCommand}" Margin="0,0,6,6"
                               Visibility="{Binding HasPolicyEntry, Converter={StaticResource BoolToVisible}}" />
                </WrapPanel>
            </StackPanel>

            <TextBlock Text="Data" Style="{StaticResource Caption}" Margin="0,8,0,6" />
            <WrapPanel>
                <ui:Button Content="Reset data…" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetDataCommand}" Margin="0,0,6,6"
                           Visibility="{Binding IsChromium, Converter={StaticResource BoolToVisible}}"
                           ToolTip="Clears its saved settings and sign-in (backed up first; the profile must be closed)" />
                <ui:Button Content="Reinstall" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ReinstallCommand}" Margin="0,0,6,6"
                           Visibility="{Binding CanReinstall, Converter={StaticResource BoolToVisible}}"
                           ToolTip="Opens its store page in this profile" />
            </WrapPanel>

            <!-- Quick links -->
            <WrapPanel Margin="0,8,0,0">
                <ui:Button Content="Copy ID" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyIdCommand}" Margin="0,0,6,6" />
                <ui:Button Content="Store page" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenStorePageCommand}" Margin="0,0,6,6"
                           Visibility="{Binding StoreUrl, Converter={StaticResource EmptyToCollapsed}}" />
                <ui:Button Content="Website" Icon="{ui:SymbolIcon Globe24}" Command="{Binding OpenHomepageCommand}" Margin="0,0,6,6"
                           Visibility="{Binding HomepageUrl, Converter={StaticResource EmptyToCollapsed}}" />
                <ui:Button Content="Show files" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding ShowFilesCommand}" Margin="0,0,6,6"
                           Visibility="{Binding FolderPath, Converter={StaticResource EmptyToCollapsed}}" />
            </WrapPanel>

            <!-- Facts -->
            <TextBlock Text="Details" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ID" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,6" FontFamily="Consolas" />
                <TextBlock Grid.Row="1" Text="Version" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="2" Text="Installed from" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="3" Text="Format" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FormatText}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="4" Text="Installed" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InstalledText}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="5" Text="Updated" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="6" Text="Type" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource FieldValue}" />
            </Grid>

            <!-- Risk -->
            <TextBlock Text="Why this risk level" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
            <TextBlock Text="Nothing notable: it only uses low-impact features." Style="{StaticResource Caption}"
                       Visibility="{Binding RiskReasons.Count, Converter={StaticResource EmptyToVisible}}" />
            <ItemsControl ItemsSource="{Binding RiskReasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="5" Height="5" Margin="2,8,10,0" VerticalAlignment="Top" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Permissions -->
            <TextBlock Text="What it can do" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
            <TextBlock Text="No special permissions." Style="{StaticResource Caption}"
                       Visibility="{Binding Permissions.Count, Converter={StaticResource EmptyToVisible}}" />
            <ItemsControl ItemsSource="{Binding Permissions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PermissionLine}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top" Fill="{Binding Weight, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Description -->
            <TextBlock Text="Description" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"
                       Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
