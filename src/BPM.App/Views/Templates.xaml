<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:BPM.App.ViewModels"
                    xmlns:views="clr-namespace:BPM.App.Views"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Look defaults for the light theme; the dark glass theme (GlassDark.xaml) overrides them. -->
    <SolidColorBrush x:Key="AppBackdropBrush" Color="Transparent" />
    <sys:Double x:Key="GlassGlowOpacity">0</sys:Double>
    <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>

    <views:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <views:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <views:EmptyToVisibilityConverter x:Key="EmptyToCollapsed" />
    <views:EmptyToVisibilityConverter x:Key="EmptyToVisible" Invert="True" />
    <views:PathToImageConverter x:Key="PathToImage" />
    <views:ArgbToBrushConverter x:Key="ArgbToBrush" />
    <views:BytesToTextConverter x:Key="BytesToText" />
    <views:StatusBrushConverter x:Key="StatusBrush" />
    <views:StatusBrushConverter x:Key="StatusTint" Background="True" />
    <views:SeverityToSymbolConverter x:Key="SeverityToSymbol" />
    <views:JoinListConverter x:Key="JoinList" />

    <!-- Pages -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BrowsersViewModel}"><views:BrowsersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AllExtensionsViewModel}"><views:AllExtensionsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChangeLogViewModel}"><views:ChangeLogView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DoctorViewModel}"><views:DoctorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SideloadsViewModel}"><views:SideloadsView /></DataTemplate>

    <!-- Text styles -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,0,12,6" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Panels -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Left navigation: subtle highlight with an accent bar instead of a solid block. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,4">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Profile avatar: picture when the browser saved one, else an initial on the profile colour. -->
    <DataTemplate x:Key="ProfileAvatar" DataType="{x:Type vm:ProfileNode}">
        <Grid>
            <Ellipse Fill="{Binding ColorArgb, Converter={StaticResource ArgbToBrush}}" />
            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Visibility="{Binding AvatarPath, Converter={StaticResource EmptyToCollapsed}}">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}, ConverterParameter=96}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </DataTemplate>

    <!-- Extension icon with a puzzle-piece fallback. -->
    <DataTemplate x:Key="ExtensionIcon">
        <Grid>
            <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IconPath, Converter={StaticResource EmptyToVisible}}" />
            <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
    </DataTemplate>

    <!-- On / Off pill. -->
    <DataTemplate x:Key="StatePill">
        <Border Style="{StaticResource Badge}" Background="{Binding Enabled, Converter={StaticResource StatusTint}}">
            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Enabled, Converter={StaticResource StatusBrush}}" />
        </Border>
    </DataTemplate>

    <!-- Risk badge. -->
    <DataTemplate x:Key="RiskBadge">
        <Border Style="{StaticResource Badge}" Background="{Binding Risk, Converter={StaticResource StatusTint}}">
            <TextBlock Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
