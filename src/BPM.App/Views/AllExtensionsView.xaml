<UserControl x:Class="BPM.App.Views.AllExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BPM.App.ViewModels"
             xmlns:views="clr-namespace:BPM.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AllExtensionsViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="8,4,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="340" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- Every extension once -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TextBox PlaceholderText="Search all extensions" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Row="1" Margin="0,8,0,8" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExtensionGroup}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Width="28" Height="28" Content="{Binding}" ContentTemplate="{StaticResource ExtensionIcon}" Focusable="False" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding VersionsText}" Style="{StaticResource Caption}" Foreground="#C88A12"
                                               Visibility="{Binding HasManyVersions, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top" Background="{Binding MaxRisk, Converter={StaticResource StatusTint}}">
                                    <TextBlock Text="{Binding RiskText}" FontSize="11" Foreground="{Binding MaxRisk, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Where the selected extension is installed -->
        <Grid Grid.Column="2" Visibility="{Binding SelectedGroup, Converter={StaticResource EmptyToCollapsed}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Panel}" Padding="16" DataContext="{Binding SelectedGroup}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Width="36" Height="36" Content="{Binding}" ContentTemplate="{StaticResource ExtensionIcon}" Focusable="False" />
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource Body}" />
                            <TextBlock Text="{Binding Id}" Style="{StaticResource Caption}" FontFamily="Consolas" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0">
                        <Run Text="{Binding Summary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding VersionsText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding BrowsersText}" Style="{StaticResource Caption}" />
                    <TextBlock Text="Pick a profile below to manage it there, or remove it from every profile at once." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <ui:Button Content="Remove from every profile…" Icon="{ui:SymbolIcon Delete24}" Margin="0,10,0,0"
                               Command="{Binding DataContext.RemoveEverywhereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               ToolTip="Uninstalls it from every profile that has it, one by one. Nothing is blocked: you can install it again any time." />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,8,0,0">
                <DataGrid ItemsSource="{Binding Installs}" SelectedItem="{Binding SelectedInstall}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" CanUserResizeRows="False" RowHeight="40" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="Browser" Binding="{Binding BrowserName}" Width="110" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                        <DataGridTemplateColumn Header="State" Width="66" SortMemberPath="StateText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatePill}" VerticalAlignment="Center" Focusable="False" ToolTip="{Binding ReasonText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <Border Grid.Column="4" Style="{StaticResource Panel}" Visibility="{Binding SelectedInstall, Converter={StaticResource EmptyToCollapsed}}">
            <views:ExtensionDetails x:Name="Details" DataContext="{Binding SelectedInstall}" />
        </Border>
    </Grid>
</UserControl>
