<UserControl x:Class="BPM.App.Views.ChangeLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BPM.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChangeLogViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="16,4,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <ui:Button DockPanel.Dock="Right" Content="Open backups folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenBackupsCommand}" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="Change log" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
                <TextBlock Text="Everything this app changed on this PC, newest first. Undo puts it back." Style="{StaticResource Caption}" Margin="0,0,0,12" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="24" VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="No changes yet. Turning extensions on or off, blocking, resetting data and shortcuts will show up here."
                       Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChangeRow}">
                        <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding StatusText, Mode=OneWay}" Foreground="#2FA04E" />
                                    </TextBlock>
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="Undo" Icon="{ui:SymbolIcon ArrowUndo24}" VerticalAlignment="Center"
                                           Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisible}}"
                                           Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
