<UserControl x:Class="BPM.App.Views.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BPM.App.ViewModels"
             xmlns:diag="clr-namespace:BPM.Core.Diagnostics;assembly=BPM.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DoctorViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <!-- Checks listed under their group headings ("Accounts", "Browser links", …), in the order HealthChecker gives -->
        <CollectionViewSource x:Key="GroupedChecks" Source="{Binding Checks}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,4,24,24">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Run checks again" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RerunCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Health" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="Accounts that need attention, profiles you don't use, broken browser links and browser policies. Nothing changes until you use a button." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Style="{StaticResource Body}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedChecks}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CheckRow}">
                        <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource SeverityToSymbol}}" FontSize="20" VerticalAlignment="Top"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                                               Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="{Binding FixText}" VerticalAlignment="Center"
                                           Visibility="{Binding HasFix, Converter={StaticResource BoolToVisible}}"
                                           Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="All browser links" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Registrations that let an extension talk to a program on this PC, such as a password manager, download manager or PDF tool. Broken ones point to programs that are gone." />
            <Border Style="{StaticResource Panel}">
                <DataGrid ItemsSource="{Binding Hosts}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" CanUserResizeRows="False" RowHeight="40" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Link" Binding="{Binding Name}" Width="*" MinWidth="200" />
                        <DataGridTextColumn Header="Used by" Binding="{Binding Browsers, Converter={StaticResource JoinList}}" Width="190" />
                        <DataGridTextColumn Header="For" Binding="{Binding Scope.Label}" Width="120" />
                        <DataGridTemplateColumn Header="Status" Width="210" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type diag:NativeHost}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" ToolTip="{Binding ProgramPath}" />
                                        <ui:Button Content="Remove…" Margin="8,0,0,0" Padding="8,2"
                                                   Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisible}}"
                                                   Command="{Binding DataContext.RemoveHostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
