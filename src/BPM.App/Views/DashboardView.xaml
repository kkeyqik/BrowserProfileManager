<UserControl x:Class="BPM.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BPM.App.ViewModels"
             xmlns:analysis="clr-namespace:BPM.Core.Analysis;assembly=BPM.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,4,24,24">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Export report…" Icon="{ui:SymbolIcon Share24}" Command="{Binding ExportCommand}"
                           VerticalAlignment="Top" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisible}}"
                           ToolTip="Save the scan as a web page, spreadsheet or JSON (emails can be hidden in Settings)" />
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <!-- Before the first scan -->
            <Border Style="{StaticResource Panel}" Padding="24" Visibility="{Binding HasScan, Converter={StaticResource BoolToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="No scan yet" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="Press “Scan this PC” to find every installed browser, its profiles and their extensions. Scanning only reads files." />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVisible}}">
                <!-- Counters -->
                <UniformGrid Columns="5">
                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding BrowserCount}" FontSize="28" FontWeight="SemiBold" Style="{StaticResource Body}" />
                            <TextBlock Text="Browsers" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ProfileCount}" FontSize="28" FontWeight="SemiBold" Style="{StaticResource Body}" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="Profiles · " /><Run Text="{Binding OpenProfileCount, Mode=OneWay}" /><Run Text=" open now" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ExtensionCount}" FontSize="28" FontWeight="SemiBold" Style="{StaticResource Body}" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="Extensions · " /><Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text=" on" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding HighRiskCount}" FontSize="28" FontWeight="SemiBold" Foreground="#D93F3F" />
                            <TextBlock Text="High-risk extensions turned on" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding WaitingCount}" FontSize="28" FontWeight="SemiBold" Foreground="#C88A12" />
                            <TextBlock Text="Waiting for approval" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Problems -->
                <TextBlock Text="Problems found" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Panel}" Padding="16" Visibility="{Binding HasNoProblems, Converter={StaticResource BoolToVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#2FA04E" FontSize="20" />
                        <TextBlock Text="Nothing needs your attention." Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Body}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type analysis:Problem}">
                            <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{Binding Severity, Converter={StaticResource SeverityToSymbol}}" FontSize="20"
                                                   Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource Body}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Content="Show" VerticalAlignment="Center"
                                               Visibility="{Binding ExtensionId, Converter={StaticResource EmptyToCollapsed}}"
                                               Command="{Binding DataContext.ShowProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Browsers -->
                <TextBlock Text="Browsers on this PC" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding BrowserCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserNode}">
                            <ui:CardAction Width="260" Margin="0,0,8,8" Padding="14"
                                           Command="{Binding DataContext.OpenBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                                    <StackPanel Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource Body}" />
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="#332FA04E"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="running" FontSize="11" Foreground="#2FA04E" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding ProfileCountText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ExtensionCount, Mode=OneWay}" /><Run Text=" extensions" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding OtherBrowsersText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Visibility="{Binding OtherBrowsersText, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
