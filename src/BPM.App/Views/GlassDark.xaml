<!-- "Dark glass" look: frosted, see-through panels over a deep violet backdrop with soft violet and cyan glows.
     Loaded by ThemeService on top of WPF-UI's dark theme (so it wins over it) and removed again for the light theme.
     Only colours, corners and the backdrop change here; layouts live in the views. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Window backdrop (drawn by MainWindow behind everything) -->
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#0E0B1F" />
    <sys:Double x:Key="GlassGlowOpacity">1</sys:Double>
    <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>

    <!-- Separate windows (dialogs) and pop-ups have no backdrop behind them, so they stay solid -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0E0B1F" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1A1530" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBackgroundBrush" Color="#1A1530" />

    <!-- Frosted panels and cards: white at low opacity, with a light rim -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#24FFFFFF" />

    <!-- Buttons, text boxes and lists -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#14FFFFFF" />

    <!-- Text: soft lavender for supporting text so it reads on the violet glow -->
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C9C3EA" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#9A93C2" />
</ResourceDictionary>
